# 用法：cp .env.example backend/.env
#
# 注意：必须放在 backend/ 目录下。pydantic 的 env_file 相对「当前工作目录」
# 解析，而服务从 backend/ 启动 —— 放在仓库根目录不会被读取。

DATABASE_URL=postgresql://kp:kp@localhost:5432/knowledgepilot
REDIS_URL=redis://localhost:6379

# ---- LLM 接入：走 OpenAI Chat Completions 兼容协议，一套配置覆盖所有部署形态 ----
# 场景① 本机 Ollama：        LLM_PROVIDER=ollama，留空 LLM_BASE_URL
# 场景② 局域网另一台 Ollama：LLM_BASE_URL=http://192.168.x.x:11434/v1
# 场景③ vLLM / Xinference：  各自的 /v1 端点
# 场景④ 第三方 API：         DeepSeek / Moonshot / 通义千问(兼容) / SiliconFlow / OpenAI
#
# 坑：别把 embedding 模型（bge-m3 等）填进 LLM_MODEL，它们只能出向量不能对话，
#     会报 "does not support chat"。用 curl http://host:11434/api/tags 查真实模型名。
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://192.168.1.50:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama          # 占位值，Ollama 不校验；第三方填真实 key

# 大模型的冷启动可能很慢（30B 约 26s），局域网/公网建议留足余量
LLM_TIMEOUT=180

# 必须显式置 0。留空时 Ollama 取默认 ≈0.8，Tier3 的拒答判定会随机翻转
# （实测同一条查询重复 5 次出现 1~2 次判定不一致）。
LLM_TEMPERATURE=0.0
